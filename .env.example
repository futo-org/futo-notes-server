# Required
DATABASE_URL=postgres://stonefruit:stonefruit@localhost:5433/stonefruit

# Server
PORT=3005
BLOB_DIR=./blobs
LOG_LEVEL=info          # debug | info | warn | error

# Auth mode: "dev" also exposes /api/auth/dev/login (no-password email login)
# for tests. Default is password-only.
AUTH_MODE=password

# Database pool
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_SSL=false            # set to "true" for remote Postgres with SSL
