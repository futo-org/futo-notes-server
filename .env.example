# Required
DATABASE_URL=postgres://futo_notes:futo_notes@localhost:5433/futo_notes

# Server
PORT=3005
BLOB_DIR=./blobs
LOG_LEVEL=info          # debug | info | warn | error

# Auth
# - "password": single-user self-hosted mode. Requires FUTO_NOTES_PASSWORD_HASH.
# - "dev":      test-only. Exposes /api/auth/dev/login for no-password email login.
AUTH_MODE=password

# Produce with:
#   bun dist/index.js hash <password>
# Only used when AUTH_MODE=password.
FUTO_NOTES_PASSWORD_HASH=

# Secure flag on the session cookie. Defaults true (false only when AUTH_MODE=dev).
# Set to "false" for plain-HTTP LAN deployments where the cookie can't ride over TLS.
#COOKIE_SECURE=true

# Login rate limiting (password mode). The server caps requests to the
# scrypt-backed login per client per window, so brute force and CPU
# amplification are blunted without a reverse-proxy rule.
# AUTH_RATE_LIMIT:           max attempts per window (default 10). Set 0 to disable.
# AUTH_RATE_LIMIT_WINDOW_MS: window length in ms (default 60000 = 1 min).
# TRUST_PROXY:               set "true" when behind a reverse proxy that sets
#                            X-Forwarded-For, so the limiter keys on the real
#                            client IP. Leave off when exposed directly (an
#                            untrusted XFF header could be spoofed to dodge it).
#AUTH_RATE_LIMIT=10
#AUTH_RATE_LIMIT_WINDOW_MS=60000
#TRUST_PROXY=false

# Blobs
# Max accepted request body size for blob uploads, in bytes (default 100 MiB).
# Applies to POST /api/blobs and the single-round-trip blob-objects routes.
MAX_BLOB_BYTES=104857600
# Cumulative payload cap for one POST /api/blobs/batch response, in bytes
# (default 32 MiB). Entries past the cap return status=omitted.
MAX_BATCH_BYTES=33554432

# Database pool
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_SSL=false            # set to "true" for remote Postgres with SSL
# When DB_SSL=true the server verifies the Postgres certificate by default.
# DB_SSL_CA:       path to a CA cert PEM, for self-signed / private-CA setups.
# DB_SSL_INSECURE: set to "true" to skip verification (encrypted but MITM-able).
#DB_SSL_CA=/path/to/ca.pem
#DB_SSL_INSECURE=false

# Blob garbage collection
# BLOB_GC_ENABLED:      set to "false" to disable the background GC (default enabled).
# BLOB_RETENTION_DAYS:  how long to keep superseded/deleted blobs (default 365 days).
# BLOB_GC_INTERVAL_MS:  how often the GC sweep runs, in ms (default 21600000 = 6h).
#BLOB_GC_ENABLED=true
#BLOB_RETENTION_DAYS=365
#BLOB_GC_INTERVAL_MS=21600000
