# Required
DATABASE_URL=postgres://stonefruit:stonefruit@localhost:5433/stonefruit

# Server
PORT=3000
BLOB_DIR=./blobs
LOG_LEVEL=info          # debug | info | warn | error

# Auth mode: "dev" for development (no password), "password" for self-hosting
AUTH_MODE=dev

# Database pool
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_SSL=false            # set to "true" for remote Postgres with SSL
