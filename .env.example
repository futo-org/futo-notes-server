# Required
DATABASE_URL=postgres://stonefruit:stonefruit@localhost:5433/stonefruit

# Server
PORT=3005
BLOB_DIR=./blobs
LOG_LEVEL=info          # debug | info | warn | error

# Auth
# - "password": single-user self-hosted mode. Requires STONEFRUIT_PASSWORD_HASH.
# - "dev":      test-only. Exposes /api/auth/dev/login for no-password email login.
AUTH_MODE=password

# Set via the installer TUI (`stonefruit setup`), or produce manually with:
#   node dist/index.js hash <password>
# Only used when AUTH_MODE=password.
STONEFRUIT_PASSWORD_HASH=

# Database pool
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_SSL=false            # set to "true" for remote Postgres with SSL
