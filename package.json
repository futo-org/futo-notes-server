{
  "name": "futo-notes-server",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "trustedDependencies": ["esbuild"],
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build.mjs",
    "build:hosted": "bun build.mjs --hosted",
    "migrate": "bun src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/test.ts",
    "test:dev": "bun scripts/test.ts dev",
    "test:password": "bun scripts/test.ts password",
    "check:production-config": "bun scripts/check-production-config.mjs",
    "check:installer": "bun scripts/check-installer.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "kysely": "^0.28.17",
    "pg": "^8.13.1",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.2"
  }
}
