#!/usr/bin/env bash
#MISE description="Run every test, including Postgres, S3 and Mailpit suites, against the hosted dev compose stack"
#MISE dir="{{config_root}}"
# Needs `mise run docker:start` first. Recreates scratch databases in the
# compose Postgres (localhost:15432) on every run, then points each opt-in suite
# at them:
#   *_TEST_DATABASE_URL    one scratch database per suite (see docs/DEVELOPMENT.md)
#   HOSTED_E2E_DATABASE_URL  the end-to-end scenario's database (e2e/hosted)
#   S3_TEST_ENDPOINT       MinIO, default http://localhost:9000
#   S3_TEST_ACCESS_KEY_ID  default minio
#   S3_TEST_SECRET_ACCESS_KEY  default miniominio
#   S3_TEST_REGION         default us-east-1 (MinIO accepts any signing region)
#   S3 buckets             notes-us-east, notes-eu-central, notes-ap-southeast
#   MAILPIT_TEST_URL       Mailpit's REST API, default http://localhost:8025
#   MAILPIT_TEST_SMTP_ADDR Mailpit's SMTP, default localhost:1025
# Extra arguments go to `go test`, e.g. `mise run test:integration -race`.
set -euo pipefail

compose=(docker compose -f compose.hosted.yml)
pg_host=${PG_TEST_HOST:-localhost:15432}

for db in objects_test events_test jobs_test blobs_test server_test migration_test hosted_test hosted_e2e; do
  "${compose[@]}" exec -T database dropdb --if-exists --force -U postgres "$db" 2>/dev/null
  "${compose[@]}" exec -T database createdb -U postgres "$db"
done
for db in objects events jobs blobs server migration hosted; do
  var="$(echo "$db" | tr '[:lower:]' '[:upper:]')_TEST_DATABASE_URL"
  export "$var=postgres://postgres:postgres@$pg_host/${db}_test"
done
export HOSTED_E2E_DATABASE_URL="postgres://postgres:postgres@$pg_host/hosted_e2e"

export S3_TEST_ENDPOINT=${S3_TEST_ENDPOINT:-http://localhost:9000}
export S3_TEST_ACCESS_KEY_ID=${S3_TEST_ACCESS_KEY_ID:-minio}
export S3_TEST_SECRET_ACCESS_KEY=${S3_TEST_SECRET_ACCESS_KEY:-miniominio}
export S3_TEST_REGION=${S3_TEST_REGION:-us-east-1}
export MAILPIT_TEST_URL=${MAILPIT_TEST_URL:-http://localhost:8025}
export MAILPIT_TEST_SMTP_ADDR=${MAILPIT_TEST_SMTP_ADDR:-localhost:1025}

# -p 1: the suites share these databases.
go test -count=1 -p 1 ./... "$@"
