#!/usr/bin/env bash
#MISE description="Build a release, start the hosted test stack from it, and run the client smoke test"
#MISE dir="{{config_root}}"
# Needs Docker. Uses the stack's default ports (3125, 3115-3117, 8192, 15532,
# 19000), leaves nothing running, and builds for this machine only into a
# temporary directory.
set -euo pipefail

out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
FUTO_RELEASE_DIR=$out FUTO_RELEASE_HOST_ONLY=1 scripts/build-release.sh smoke >/dev/null
scripts/hosted-stack-smoke.sh "$out" smoke
