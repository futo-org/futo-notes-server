# FUTO Notes server - production environment.
# Copy this file to `.env` next to docker-compose.yml, fill in the password,
# then run: docker compose up -d
# Keep the real `.env` private: chmod 600 .env

# REQUIRED: the sync password you enter in the app. Plaintext is fine as long
# as this file is only readable by you.
FUTO_NOTES_PASSWORD=
# OPTIONAL: where the server keeps its data on the host. Use an absolute path.
# Holds both the SQLite database and the encrypted blobs, so backing up this
# one directory backs up the whole server.
# Default: ./futo-notes-data next to this file.
#FUTO_NOTES_DATA_DIR=/srv/futo-notes/futo-notes-data

# OPTIONAL: host port to expose the server on. Default: 3005
#FUTO_NOTES_PORT=3005

# OPTIONAL: mark the session cookie Secure, so browsers send it only over
# HTTPS. Default: true. Set it to false only if you reach the server over
# plain http:// from a browser; the mobile apps use a bearer token and are
# unaffected either way.
#COOKIE_SECURE=true

# OPTIONAL: server image. Pin to a specific tag for predictable upgrades.
#FUTO_NOTES_IMAGE=futotech/notes-server:stable
