# FUTO Notes server — production environment.
# Copy this file to `.env` next to docker-compose.yml, fill in the two
# required values, then run: docker compose up -d

# REQUIRED: scrypt hash of your admin password.
# Generate with:
#   docker run --rm gitlab.futo.org:5050/futo-notes/futo-notes-server/server:stable \
#     node dist/index.js hash 'your-admin-password'
FUTO_NOTES_PASSWORD_HASH=

# REQUIRED: a strong random string for the Postgres user.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# OPTIONAL: where to keep encrypted blobs and Postgres data on the host.
# Defaults to ./futo-notes-data next to this file. Back this directory up
# (along with .env) to back up your notes.
#FUTO_NOTES_DATA_DIR=./futo-notes-data

# OPTIONAL: host port to expose the server on. Default: 3005
#FUTO_NOTES_PORT=3005

# OPTIONAL: server image. Pin to a specific tag for predictable upgrades.
#FUTO_NOTES_IMAGE=gitlab.futo.org:5050/futo-notes/futo-notes-server/server:stable

# OPTIONAL: log level (debug | info | warn | error). Default: info
#LOG_LEVEL=info

# OPTIONAL: TLS to a remote Postgres. The bundled compose talks to a local
# Postgres over the Docker network, so most installs leave this off.
# When DB_SSL=true the server now verifies the Postgres certificate by default.
# For a self-signed / private-CA database, point DB_SSL_CA at the CA PEM, or
# set DB_SSL_INSECURE=true to skip verification (encrypted but MITM-able).
#DB_SSL=false
#DB_SSL_CA=/path/to/ca.pem
#DB_SSL_INSECURE=false
