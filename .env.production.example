# FUTO Notes server — production environment.
# Copy this file to `.env` next to docker-compose.yml, fill in the two
# required values, then run: docker compose up -d

# REQUIRED: admin password. Plaintext is easiest; keep this file mode 0600.
FUTO_NOTES_PASSWORD=
# Safer at rest: clear FUTO_NOTES_PASSWORD and set a scrypt hash instead.
# Generate it with the server image's `bun dist/index.js hash <password>` CLI.
# Never set both alternatives; startup rejects ambiguous configuration.
#FUTO_NOTES_PASSWORD_HASH=

# REQUIRED: a strong random string for the Postgres user.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# OPTIONAL: where to keep encrypted blobs and Postgres data on the host.
# Defaults to ./futo-notes-data next to this file. Back this directory up
# (along with .env) to back up your notes.
#FUTO_NOTES_DATA_DIR=./futo-notes-data

# OPTIONAL: host directory mounted read-only at /config, for a Postgres CA.
#FUTO_NOTES_CONFIG_DIR=./config

# OPTIONAL: host port to expose the server on. Default: 3005
#FUTO_NOTES_PORT=3005

# OPTIONAL: server image. Pin to a specific tag for predictable upgrades.
#FUTO_NOTES_IMAGE=gitlab.futo.org:5050/futo-notes/futo-notes-server/server:stable

# OPTIONAL: log level (debug | info | warn | error). Default: info
#LOG_LEVEL=info

# OPTIONAL: set false only for a plain-HTTP LAN deployment. Default: true
#COOKIE_SECURE=true

# OPTIONAL: login rate limiting. The server already caps requests to the
# admin login (default 10 per minute per client), so you don't need a
# reverse-proxy rule for it. If you run behind a reverse proxy (the
# usual setup for HTTPS — see the README), set TRUST_PROXY=true so the limit
# keys on the real client IP instead of the proxy's. Tune or disable with
# AUTH_RATE_LIMIT (0 = off) and AUTH_RATE_LIMIT_WINDOW_MS.
#TRUST_PROXY=true
#AUTH_RATE_LIMIT=10
#AUTH_RATE_LIMIT_WINDOW_MS=60000

# OPTIONAL: upload and batch-response caps, in bytes.
#MAX_BLOB_BYTES=104857600
#MAX_BATCH_BYTES=33554432

# OPTIONAL: orphaned-blob garbage collection.
#BLOB_GC_ENABLED=true
#BLOB_RETENTION_DAYS=365
#BLOB_GC_INTERVAL_MS=21600000

# OPTIONAL: Postgres pool sizing.
#DB_POOL_MAX=10
#DB_POOL_IDLE_TIMEOUT_MS=10000

# OPTIONAL: replace the bundled Postgres connection entirely.
#DATABASE_URL=postgres://user:password@db.example:5432/futo_notes

# OPTIONAL: TLS to a remote Postgres. The bundled compose talks to a local
# Postgres over the Docker network, so most installs leave this off.
# When DB_SSL=true the server now verifies the Postgres certificate by default.
# For a self-signed/private CA, place the PEM under FUTO_NOTES_CONFIG_DIR and
# use its container path (for example /config/postgres-ca.pem). Alternatively,
# DB_SSL_INSECURE skips verification (encrypted but vulnerable to MITM).
#DB_SSL=false
#DB_SSL_CA=/config/postgres-ca.pem
#DB_SSL_INSECURE=false
